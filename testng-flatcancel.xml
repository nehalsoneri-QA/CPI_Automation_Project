<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CPI Flat Cancel Test Suite" verbose="1">

    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>

    <test name="Flat Cancel Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="flatcancel"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.tests.FlatCancelTest">
                <methods>
                    <include name="testLoginWithValidCredentials"/>
                    <include name="testClickSkipButtonOnResetPage"/>
                    <include name="testNavigateToHomePage"/>
                    <include name="testClickOnManagePolicyLink"/>
                    <include name="testProcessFlatCancelForAllPolicies"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
