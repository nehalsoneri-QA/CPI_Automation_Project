<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Create Premium Endorsement Test Suite" verbose="1">

    <test name="Create Premium Endorsement Tests">
        <classes>
            <class name="com.automation.tests.CreatePremiumEndorsementTest">
                <methods>
                    <!-- Flow: Login -> Create Quote -> Submit -> Bind -> Master Policy -> Create Premium Endorsement -> Edit Premium Endorsement -->

                    <!-- Login and Quote Creation -->
                    <include name="testPositiveLogin"/>
                    <include name="testEnterDataOnCreateQuote"/>
                    <include name="testClickSubmitButton"/>
                    <include name="testClickBindButton"/>
                    <include name="testClickPremiumEndorsementButton"/>

                    <!-- Create Premium Endorsement Page Tests -->
                    <include name="testVerifyEndorsementPageURL"/>
                    <include name="testVerifyEndorsementPageLoaded"/>
                    <include name="testCaptureEndorsementFormValues"/>
                    <include name="testVerifySubmitButtonState"/>
                    <include name="testValidateDisplayComputations"/>
                    <include name="testChangeEndorsementEffectiveDate"/>
                    <include name="testAddLocationsOnEndorsement"/>
                    <include name="testValidatePremiumCalculations"/>
                    <include name="testCaptureAllEndorsementData"/>
                    <include name="testClickCreateEndorsementButton"/>

                    <!-- Edit Premium Endorsement Page Tests -->
                    <include name="testValidateEditEndorsementData"/>
                    <include name="testAddLocationsOnEditEndorsement"/>
                    <include name="testChangeEditEndorsementDate"/>
                    <include name="testValidateEditEndorsementPremiums"/>
                    <include name="testValidateEditDisplayComputations"/>
                    <include name="testValidatePDFEndorsement"/>

                    <!-- Update, Bind, and PDF Comparison Tests -->
                    <include name="testClickUpdateEndorsementButton"/>
                    <include name="testClickBindButtonOnEditEndorsement"/>
                    <include name="testValidateMasterPolicyURL"/>
                    <include name="testDownloadBindHistoryPDF"/>
                    <include name="testComparePDFs"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
