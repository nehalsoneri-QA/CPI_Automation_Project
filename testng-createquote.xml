<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Create Quote Test Suite" verbose="1" preserve-order="true">

  <!-- Suite Level Listeners -->
  <listeners>
    <listener class-name="com.automation.listeners.TestListener"/>
  </listeners>

  <!-- Create Quote Test - All Tests -->
  <test name="Create Quote Tests" preserve-order="true">
    <classes>
      <class name="com.automation.tests.CreateQuoteTest">
        <methods>
          <include name="testLoginWithValidCredentials"/>
          <include name="testNavigateToCreateQuotePage"/>
          <include name="testWithEmptyData"/>
          <include name="testSubmitDisabledUntilComplete"/>
          <include name="testResetFormData"/>
          <include name="testFillQuoteFormWithValidDataFinal"/>
          <include name="testValidatePremiumCalculations"/>
        </methods>
      </class>
    </classes>
  </test>

</suite>
